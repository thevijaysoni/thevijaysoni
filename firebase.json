{
  "hosting": {
    "site": "thevijaysoniweb",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/labs/kalachakra",
        "destination": "/labs/kalachakra/index.html"
      },
      {
        "source": "/labs/kalachakra/**",
        "destination": "/labs/kalachakra/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
